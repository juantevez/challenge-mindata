          }
        },
        {
          "name": "POST /search (otras edades)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('searchIdOtherAges', pm.response.json().searchId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"checkIn\": \"29/12/2023\",\n  \"checkOut\": \"31/12/2023\",\n  \"ages\": [30, 29]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            }
          }
        },
        {
          "name": "GET /count (búsquedas iguales -> 2)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// La persistencia es asíncrona: se da tiempo al consumidor de Kafka.",
                  "setTimeout(() => {}, Number(pm.collectionVariables.get('asyncWaitMs')));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('searchId coincide', () => pm.expect(body.searchId).to.eql(pm.collectionVariables.get('searchId')));",
                  "pm.test('cuenta 2 (el orden de edades no importa)', () => pm.expect(body.count).to.eql(2));",
                  "pm.test('devuelve la búsqueda tal como se envió', () => {",
                  "  pm.expect(body.search.hotelId).to.eql(pm.collectionVariables.get('hotelId'));",
                  "  pm.expect(body.search.checkIn).to.eql('29/12/2023');",
                  "  pm.expect(body.search.checkOut).to.eql('31/12/2023');",
                  "  pm.expect(body.search.ages).to.eql([30, 29, 1, 3]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/count?searchId={{searchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "count"
              ],
              "query": [
                {
                  "key": "searchId",
                  "value": "{{searchId}}"
                }
              ]
            }
          }
        },
        {
          "name": "GET /count (otras edades -> 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('cuenta 1', () => pm.expect(pm.response.json().count).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/count?searchId={{searchIdOtherAges}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "count"
              ],
              "query": [
                {
                  "key": "searchId",
                  "value": "{{searchIdOtherAges}}"
                }
              ]
            }
          }
        }
      ]
