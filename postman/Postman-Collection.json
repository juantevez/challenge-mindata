    {
      "name": "CORS",
      "item": [
        {
          "name": "OPTIONS /search - origen permitido (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('permite el origen', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('corsOrigin')));",
                  "pm.test('permite POST', () => pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('POST'));"
                ]
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
