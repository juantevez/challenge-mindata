            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"{{hotelId}}\",\n  \"checkIn\": \"29/12/2023\",\n  \"checkOut\": \"31/12/2023\",\n  \"ages\": [3, 29, 30, 1]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
